{
  "name": "@frontline/desktop",
  "productName": "Frontline Ecom",
  "version": "0.1.0",
  "description": "Command center for running several ecommerce stores with AI agent squads.",
  "author": "Frontline Ecom",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --external:electron --outfile=dist/main.js",
    "start": "pnpm --filter @frontline/web build && pnpm build && electron .",
    "icon": "electron scripts/icon.mjs",
    "package": "pnpm --filter @frontline/web build && pnpm build && node scripts/stage.mjs && electron-builder --win",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.frontline-ecom.app",
    "productName": "Frontline Ecom",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main.js",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/resources",
        "to": "."
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
